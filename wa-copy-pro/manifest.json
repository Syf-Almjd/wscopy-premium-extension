{
  "manifest_version": 3,
  "name": "Simple WhatsApp Copier (PRO+ for free)",
  "short_name": "Simple WhatsApp Copier",
  "version": "1.2.0",
  "description": "Copy or export WhatsApp Web chats with tracked images, full files (PDF, Word, docs), voice note transcripts, and AI formatting. 100% free & local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple WhatsApp Copier (PRO+ for free)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["exporter.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "print.html",
        "print.js",
        "exporter.js",
        "interceptor.js"
      ],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle Simple WhatsApp Copier"
    }
  }
}
